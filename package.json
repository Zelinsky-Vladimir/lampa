{
  "name": "lampa-reader",
  "productName": "Lampa",
  "version": "0.6.1",
  "description": "Lampa — a cross-platform FB2 / EPUB / TXT reader with infinite scroll, themes, bookmarks and notes",
  "main": "main.js",
  "author": "Zelinsky-Vladimir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/build-fonts.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.zelinskyvladimir.svitok",
    "productName": "Lampa",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "fb2",
        "name": "FictionBook",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "EPUB",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.books",
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "lampa",
      "maintainer": "Vladimir <34725004+Zelinsky-Vladimir@users.noreply.github.com>",
      "synopsis": "Book reader with infinite scroll"
    },
    "appImage": {
      "artifactName": "${productName}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-linux-amd64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zelinsky-Vladimir",
        "repo": "lampa"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
